{
	"name": "@pierregoutheraud/react-identicons",
	"version": "1.0.0",
	"description": "React component to generate identicons",
	"keywords": [
		"react",
		"identicon",
		"seed",
		"avatar",
		"hash",
		"image",
		"generated"
	],
	"author": "github.com/pierregoutheraud",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pierregoutheraud/identicons.git",
		"directory": "packages/react"
	},
	"homepage": "https://svelte-identicons.vercel.app/",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"!**/*.test.*",
		"!src/test-setup.ts"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "vite",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"test:unit": "vitest",
		"prepublishOnly": "pnpm run build && publint"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"dependencies": {
		"@pierregoutheraud/identicons-core": "workspace:^"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.19.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^30.1.1",
		"publint": "^0.3.25",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"typescript": "^5.9.3",
		"vite": "^8.3.2",
		"vitest": "^4.1.11"
	}
}
