{
	"name": "identicons",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.11.0",
	"scripts": {
		"build": "pnpm -r build",
		"build:libs": "pnpm --filter @pierregoutheraud/identicons-core build && pnpm --filter @pierregoutheraud/react-identicons build && pnpm --filter svelte-identicons package",
		"dev:svelte": "pnpm --filter svelte-identicons dev",
		"dev:react": "pnpm --filter @pierregoutheraud/react-identicons dev",
		"test": "pnpm -r test",
		"check": "pnpm --filter @pierregoutheraud/identicons-core build && pnpm -r check",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^4.0.0"
	}
}
